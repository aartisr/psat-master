rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is operating on their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{allChildren=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Feedback and bug reports collection
    match /feedback/{feedbackId} {
      allow create: if request.resource.data.subject is string &&
                       request.resource.data.description is string;
      allow read: if isAuthenticated() && (
        request.auth.token.email == 'aarti.sri.ravikumar@gmail.com' ||
        request.auth.token.email == 'ravikumar.raman@gmail.com' ||
        resource.data.authorUid == request.auth.uid
      );
    }

    // Community feature requests and voting
    match /feature_requests/{requestId} {
      allow read: if true;
      allow create: if request.resource.data.title is string &&
                       request.resource.data.description is string;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasAny(['upvotes', 'voterUids']);
      allow delete: if isAuthenticated() && (
        request.auth.token.email == 'aarti.sri.ravikumar@gmail.com' ||
        request.auth.token.email == 'ravikumar.raman@gmail.com'
      );
    }
  }
}
